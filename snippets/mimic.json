{
  "Program": {
    "prefix": "main",
    "body": [
      "module main",
      "",
      "fn main() {",
      "    $0",
      "}"
    ],
    "description": "A program: module main and fn main"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:x}: ${3:i64}) -> ${4:i64} {",
      "    $0",
      "}"
    ],
    "description": "A function"
  },
  "Test": {
    "prefix": "test",
    "body": [
      "test \"${1:what it checks}\" {",
      "    expect(${2:actual} == ${3:expected})",
      "}"
    ],
    "description": "A test block, run by mimic test"
  },
  "Record type": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = { ${2:field}: ${3:str} }"
    ],
    "description": "A record type"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:Some(x)} => ${3:x},",
      "    ${4:_} => ${5:0},",
      "}"
    ],
    "description": "Pattern matching"
  },
  "Doc example": {
    "prefix": "example",
    "body": [
      "// > ${1:expression}",
      "// ${2:value}"
    ],
    "description": "An example in a comment, run as a test by mimic test"
  },
  "Property test": {
    "prefix": "testfor",
    "body": [
      "test \"${1:what holds}\" for ${2:x}: ${3:i64} {",
      "\texpect(${4:$2 + 0 == $2})",
      "}"
    ],
    "description": "A property test: run with many generated values, shrunk to a small failing one"
  },
  "Contract": {
    "prefix": "fnreq",
    "body": [
      "fn ${1:name}(${2:x}: ${3:i64}) -> ${4:i64}",
      "\trequires ${5:$2 >= 0}",
      "\tensures ${6:result >= 0}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "A function with a contract (checked in debug and test builds)"
  },
  "Union type": {
    "prefix": "union",
    "body": [
      "type ${1:Shape} = ${2:Circle}(${3:f64}) | ${4:Square}(${5:f64})"
    ],
    "description": "A union type"
  },
  "Extern C": {
    "prefix": "externc",
    "body": [
      "extern \"C\" ${1:pure} {",
      "\tfn ${2:sqrt}(x: f64) -> f64",
      "}"
    ],
    "description": "Functions from C (called as c::name)"
  },
  "Each": {
    "prefix": "each",
    "body": [
      "${1:xs} ¨ (${2:x} => ${3:$2 × 2})"
    ],
    "description": "Apply a function to every element (in parallel)"
  },
  "Let else": {
    "prefix": "letelse",
    "body": [
      "let ${1:x} = ${2:parse_int(s)} else {",
      "\treturn ${3:0}",
      "}"
    ],
    "description": "Unwrap Ok/Some, or leave"
  },
  "Module": {
    "prefix": "module",
    "body": [
      "module ${1:name}",
      "",
      "$0"
    ],
    "description": "A module"
  }
}
