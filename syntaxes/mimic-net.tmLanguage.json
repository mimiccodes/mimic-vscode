{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mimic Net",
  "scopeName": "source.mimic-net",
  "fileTypes": [
    "mnet"
  ],
  "patterns": [
    {
      "name": "comment.line.double-slash.mimic-net",
      "begin": "//",
      "end": "$"
    },
    {
      "match": "^(@[A-Za-z_][A-Za-z0-9_.]*)\\s*(=)",
      "captures": {
        "1": {
          "name": "entity.name.function.mimic-net"
        },
        "2": {
          "name": "keyword.operator.assignment.mimic-net"
        }
      }
    },
    {
      "name": "entity.name.function.call.mimic-net",
      "match": "@[A-Za-z_][A-Za-z0-9_.]*"
    },
    {
      "name": "constant.numeric.mimic-net",
      "match": "#-?\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?"
    },
    {
      "name": "keyword.operator.node.mimic-net",
      "match": "\\$(?:[A-Za-z_][A-Za-z0-9_]*|[-+*/%<>=!&|^~]+)"
    },
    {
      "name": "constant.numeric.label.mimic-net",
      "match": "(?<=\\{)\\d+\\b"
    },
    {
      "name": "keyword.control.switch.mimic-net",
      "match": "\\?(?=\\()"
    },
    {
      "name": "keyword.operator.redex.mimic-net",
      "match": "~"
    },
    {
      "name": "keyword.operator.pair.mimic-net",
      "match": "&"
    },
    {
      "name": "constant.language.eraser.mimic-net",
      "match": "\\*"
    },
    {
      "name": "punctuation.section.duplicator.mimic-net",
      "match": "[{}]"
    },
    {
      "name": "punctuation.section.constructor.mimic-net",
      "match": "[()]"
    },
    {
      "name": "variable.other.wire.mimic-net",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  ]
}