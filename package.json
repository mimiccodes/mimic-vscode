{
  "name": "mimic",
  "displayName": "Mimic",
  "description": "The Mimic language: highlighting, errors as you type, hover, go to definition, glyph input, formatting, Run, Test and Debug, the test explorer, the manual, and installing Mimic.",
  "version": "0.10.3",
  "publisher": "mimiccodes",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0A0A0A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mimiccodes/mimic-vscode"
  },
  "bugs": {
    "url": "https://github.com/mimiccodes/mimic-vscode/issues"
  },
  "homepage": "https://github.com/mimiccodes/mimic",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Testing",
    "Snippets"
  ],
  "keywords": [
    "mimic",
    "array",
    "parallel",
    "glyphs",
    "apl"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onDebugDynamicConfigurations:mimic",
    "onDebugResolve:mimic",
    "onLanguage:mimic",
    "onLanguage:mimic-net",
    "onNotebook:mimic-notebook",
    "onView:mimic.glyphs",
    "workspaceContains:**/mim.mim"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mimic",
        "aliases": [
          "Mimic",
          "mimic"
        ],
        "extensions": [
          ".mim"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/mim-file.svg",
          "dark": "./images/mim-file.svg"
        }
      },
      {
        "id": "mimic-net",
        "aliases": [
          "Mimic Net",
          "mimic-net"
        ],
        "extensions": [
          ".mnet"
        ],
        "configuration": "./language-configuration-net.json",
        "icon": {
          "light": "./images/mim-file.svg",
          "dark": "./images/mim-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mimic",
        "scopeName": "source.mimic",
        "path": "./syntaxes/mimic.tmLanguage.json"
      },
      {
        "language": "mimic-net",
        "scopeName": "source.mimic-net",
        "path": "./syntaxes/mimic-net.tmLanguage.json"
      },
      {
        "scopeName": "markdown.mimic.codeblock",
        "path": "./syntaxes/markdown-codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.mimic": "mimic"
        }
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "foreign",
        "description": "A name from C or C++ (c::, cpp::, an `as` name)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "mimic",
        "scopes": {
          "namespace.foreign": [
            "entity.name.namespace.foreign.mimic"
          ],
          "function.foreign": [
            "support.function.foreign.mimic",
            "entity.name.function.mimic"
          ],
          "type.foreign": [
            "support.type.foreign.mimic",
            "entity.name.type.mimic"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Mimic",
      "properties": {
        "mimic.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `mimic` program, as a full path. Leave empty to find it as your terminal does (VS Code's `PATH`, then your shell's), then where the installers put it (`~/.mimic/bin`)."
        },
        "mimic.languageServer.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run `mimic lsp`: errors as you type, hover, go to definition, completion and formatting."
        },
        "mimic.checkVersion": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check that `mimic` is new enough for this extension, and offer the download when it is not."
        },
        "mimic.codeLens.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show **Run** above `fn main` and **Run test** above each `test` block."
        },
        "mimic.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Once a day, check GitHub for a newer Mimic and a newer version of this extension."
        },
        "mimic.profile.showInCode": {
          "type": "boolean",
          "default": true,
          "description": "After a profile, show each function's share of the time at the end of its first line."
        },
        "mimic.glyphInput": {
          "type": "boolean",
          "default": true,
          "description": "Turn a backslash digraph into its glyph as you type (`\\i` becomes `⍳`), except in strings and comments."
        },
        "mimic.target": {
          "type": "string",
          "default": "",
          "description": "The target of the Build and Run tasks (`--target`), e.g. `x86_64-linux-musl`; empty for this machine."
        },
        "mimic.audit.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `mimic audit` when a Mimic file is saved and show its findings in Problems."
        },
        "mimic.mcp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Offer `mimic mcp` to agents in VS Code (VS Code 1.101 and newer): check, build, run and test Mimic, read the manual."
        },
        "mimic.mcp.allowOutside": {
          "type": "boolean",
          "default": false,
          "description": "Let agents read and write files outside the project (`--allow-outside`)."
        },
        "mimic.mcp.allowInstall": {
          "type": "boolean",
          "default": false,
          "description": "Let agents install libraries (`--allow-install`)."
        },
        "mimic.mcp.allowNetwork": {
          "type": "boolean",
          "default": false,
          "description": "Let agents run programs that use the network or run other programs (`--allow-network`)."
        },
        "mimic.mcp.readOnly": {
          "type": "boolean",
          "default": false,
          "description": "Agents only read, check and look up (`--read-only`)."
        },
        "mimic.mcp.noRun": {
          "type": "boolean",
          "default": false,
          "description": "Agents do not run programs or tests (`--no-run`)."
        },
        "mimic.format.onSave": {
          "type": "string",
          "enum": [
            "off",
            "words",
            "glyphs"
          ],
          "default": "off",
          "enumDescriptions": [
            "Leave the file as written (format with Shift+Alt+F: it keeps the file's style)",
            "Format on save, primitives and operators as words (`iota`, `|>`)",
            "Format on save, primitives and operators as glyphs (`⍳`, `▷`)"
          ],
          "description": "Format Mimic files when they are saved (`mimic fmt`), in words or in glyphs."
        }
      }
    },
    "configurationDefaults": {
      "[mimic]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.nonBasicASCII": false,
        "editor.wordBasedSuggestions": "off"
      }
    },
    "commands": [
      {
        "command": "mimic.insertGlyph",
        "title": "Insert Glyph…",
        "category": "Mimic",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "mimic.run",
        "title": "Run",
        "category": "Mimic",
        "icon": "$(play)"
      },
      {
        "command": "mimic.debug",
        "title": "Debug",
        "category": "Mimic",
        "icon": "$(debug-alt)"
      },
      {
        "command": "mimic.test",
        "title": "Run Tests",
        "category": "Mimic",
        "icon": "$(beaker)"
      },
      {
        "command": "mimic.check",
        "title": "Check",
        "category": "Mimic"
      },
      {
        "command": "mimic.openManual",
        "title": "Open the Manual…",
        "category": "Mimic",
        "icon": "$(book)"
      },
      {
        "command": "mimic.manualForWord",
        "title": "Manual for the Word under the Cursor",
        "category": "Mimic"
      },
      {
        "command": "mimic.searchManual",
        "title": "Search the Manual…",
        "category": "Mimic"
      },
      {
        "command": "mimic.toGlyphs",
        "title": "Convert File to Glyphs",
        "category": "Mimic"
      },
      {
        "command": "mimic.toWords",
        "title": "Convert File to Words",
        "category": "Mimic"
      },
      {
        "command": "mimic.restartServer",
        "title": "Restart the Language Server",
        "category": "Mimic"
      },
      {
        "command": "mimic.showOutput",
        "title": "Show the Language Server's Output",
        "category": "Mimic"
      },
      {
        "command": "mimic.install",
        "title": "Install or Update Mimic",
        "category": "Mimic"
      },
      {
        "command": "mimic.checkForUpdates",
        "title": "Check for a Newer Mimic",
        "category": "Mimic"
      },
      {
        "command": "mimic.choosePath",
        "title": "Choose the mimic Program…",
        "category": "Mimic"
      },
      {
        "command": "mimic.status",
        "title": "Show Mimic Status",
        "category": "Mimic"
      },
      {
        "command": "mimic.profile",
        "title": "Profile",
        "category": "Mimic",
        "icon": "$(flame)"
      },
      {
        "command": "mimic.showProfile",
        "title": "Show the Last Profile",
        "category": "Mimic"
      },
      {
        "command": "mimic.refreshWhere",
        "title": "Refresh Where Code Runs",
        "category": "Mimic",
        "icon": "$(refresh)"
      },
      {
        "command": "mimic.openRepl",
        "title": "Open REPL",
        "category": "Mimic"
      },
      {
        "command": "mimic.sendToRepl",
        "title": "Send Selection to REPL",
        "category": "Mimic"
      },
      {
        "command": "mimic.openAt",
        "title": "Open Location",
        "category": "Mimic"
      },
      {
        "command": "mimic.showNet",
        "title": "Show Interaction Net",
        "category": "Mimic",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "mimic.newProject",
        "title": "New Project…",
        "category": "Mimic"
      },
      {
        "command": "mimic.addDependency",
        "title": "Add a Dependency…",
        "category": "Mimic"
      },
      {
        "command": "mimic.installDeps",
        "title": "Install Dependencies",
        "category": "Mimic"
      },
      {
        "command": "mimic.pickTarget",
        "title": "Choose the Build Target…",
        "category": "Mimic"
      },
      {
        "command": "mimic.docPreview",
        "title": "Preview the Docs",
        "category": "Mimic"
      },
      {
        "command": "mimic.uiPreview",
        "title": "Preview the UI",
        "category": "Mimic"
      },
      {
        "command": "mimic.runManualExample",
        "title": "Run an Example from the Manual…",
        "category": "Mimic"
      },
      {
        "command": "mimic.agentGuide",
        "title": "Writing Mimic with Agents",
        "category": "Mimic"
      },
      {
        "command": "mimic.refreshModules",
        "title": "Refresh Project",
        "category": "Mimic",
        "icon": "$(refresh)"
      },
      {
        "command": "mimic.runExample",
        "title": "Run Example",
        "category": "Mimic"
      },
      {
        "command": "mimic.manualPage",
        "title": "Open a Manual Page",
        "category": "Mimic"
      },
      {
        "command": "mimic.keepCase",
        "title": "Keep the Failing Case as a Test",
        "category": "Mimic"
      },
      {
        "command": "mimic.newNotebook",
        "title": "New Notebook",
        "category": "Mimic"
      },
      {
        "command": "mimic.restartNotebook",
        "title": "Restart the Notebook's Session",
        "category": "Mimic"
      },
      {
        "command": "mimic.showArray",
        "title": "Show as Table and Chart",
        "category": "Mimic"
      }
    ],
    "keybindings": [
      {
        "command": "mimic.insertGlyph",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus && editorLangId == mimic"
      },
      {
        "command": "mimic.manualForWord",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId == mimic"
      },
      {
        "command": "mimic.sendToRepl",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == mimic && mimic.replOpen"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mimic.run",
          "when": "editorLangId == mimic",
          "group": "navigation@1"
        },
        {
          "command": "mimic.debug",
          "when": "editorLangId == mimic",
          "group": "navigation@1"
        },
        {
          "command": "mimic.insertGlyph",
          "when": "editorLangId == mimic",
          "group": "navigation@2"
        },
        {
          "command": "mimic.showNet",
          "when": "editorLangId == mimic-net",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mimic.manualForWord",
          "when": "editorLangId == mimic",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "mimic.profile",
          "when": "view == mimic.hot",
          "group": "navigation"
        },
        {
          "command": "mimic.refreshWhere",
          "when": "view == mimic.where",
          "group": "navigation"
        },
        {
          "command": "mimic.refreshModules",
          "when": "view == mimic.modules",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mimic.openAt",
          "when": "false"
        },
        {
          "command": "mimic.runExample",
          "when": "false"
        },
        {
          "command": "mimic.manualPage",
          "when": "false"
        },
        {
          "command": "mimic.keepCase",
          "when": "false"
        },
        {
          "command": "mimic.showArray",
          "when": "false"
        }
      ],
      "debug/variables/context": [
        {
          "command": "mimic.showArray",
          "when": "debugType == mimic",
          "group": "navigation"
        }
      ]
    },
    "snippets": [
      {
        "language": "mimic",
        "path": "./snippets/mimic.json"
      }
    ],
    "breakpoints": [
      {
        "language": "mimic"
      }
    ],
    "debuggers": [
      {
        "type": "mimic",
        "label": "Mimic",
        "languages": [
          "mimic"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "default": "${file}",
                "description": "A .mim file, or a project folder (its mim.mim) to build and debug"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Arguments for the program"
              },
              "cwd": {
                "type": "string",
                "description": "The folder the program runs in (default: the project's, or the file's)"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Environment variables for the program"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mimic",
            "request": "launch",
            "name": "Debug the project",
            "program": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Mimic: Debug the project",
            "body": {
              "type": "mimic",
              "request": "launch",
              "name": "Debug the project",
              "program": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Mimic: Debug this file",
            "body": {
              "type": "mimic",
              "request": "launch",
              "name": "Debug this file",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "walkthroughs": [
      {
        "id": "mimic.start",
        "title": "Get Started with Mimic",
        "description": "Install Mimic, write and run a program, type glyphs, test and debug.",
        "steps": [
          {
            "id": "install",
            "title": "Install Mimic",
            "description": "The extension finds Mimic where its installer puts it (~/.mimic/bin) or on your PATH. If you have none yet:\n[Install Mimic](command:mimic.install)",
            "media": {
              "markdown": "walkthrough/install.md"
            },
            "completionEvents": [
              "onCommand:mimic.install"
            ]
          },
          {
            "id": "project",
            "title": "Create a project",
            "description": "Make a folder with a project in it, then open it.\n[New Project in a Terminal](command:workbench.action.terminal.new)",
            "media": {
              "markdown": "walkthrough/project.md"
            }
          },
          {
            "id": "glyphs",
            "title": "Type glyphs",
            "description": "Every glyph has a word, and a shortcut: type `\\i` for `⍳`. Or open the palette.\n[Open the Glyph Palette](command:mimic.insertGlyph)",
            "media": {
              "markdown": "walkthrough/glyphs.md"
            },
            "completionEvents": [
              "onCommand:mimic.insertGlyph"
            ]
          },
          {
            "id": "run",
            "title": "Run, test and debug",
            "description": "**▶ Run** above `fn main`, **▶ Run test** above each test, the Test Explorer, and **Debug** (F5).",
            "media": {
              "markdown": "walkthrough/run.md"
            }
          },
          {
            "id": "manual",
            "title": "Read the manual",
            "description": "The whole manual is inside Mimic. F1 on a word in the code opens its page.\n[Open the Manual](command:mimic.openManual)",
            "media": {
              "markdown": "walkthrough/manual.md"
            },
            "completionEvents": [
              "onCommand:mimic.openManual"
            ]
          }
        ]
      },
      {
        "id": "mimic.learn",
        "title": "Learn Mimic",
        "description": "The tutorial, chapter by chapter, beside your code.",
        "steps": [
          {
            "id": "ch1",
            "title": "1. Getting started",
            "description": "Values, `print`, running a file.\n[Read chapter 1](command:mimic.manualPage?%5B%221%22%5D)",
            "media": {
              "markdown": "walkthrough/learn.md"
            },
            "completionEvents": [
              "onCommand:mimic.manualPage"
            ]
          },
          {
            "id": "ch3",
            "title": "3. Arrays and glyphs",
            "description": "`⍳ 10 ▷ +/`: every glyph has a word.\n[Read chapter 3](command:mimic.manualPage?%5B%223%22%5D)",
            "media": {
              "markdown": "walkthrough/learn.md"
            },
            "completionEvents": [
              "onCommand:mimic.manualPage"
            ]
          },
          {
            "id": "ch4",
            "title": "4. No loops",
            "description": "`¨`, recursion, `evolve` and `settle` instead of loops.\n[Read chapter 4](command:mimic.manualPage?%5B%224%22%5D)",
            "media": {
              "markdown": "walkthrough/learn.md"
            },
            "completionEvents": [
              "onCommand:mimic.manualPage"
            ]
          },
          {
            "id": "ch5",
            "title": "5. Records, unions and match",
            "description": "Data types, and `match` that checks every case.\n[Read chapter 5](command:mimic.manualPage?%5B%225%22%5D)",
            "media": {
              "markdown": "walkthrough/learn.md"
            },
            "completionEvents": [
              "onCommand:mimic.manualPage"
            ]
          },
          {
            "id": "ch7",
            "title": "7. Errors without exceptions",
            "description": "`Result`, `else`, and errors you cannot forget.\n[Read chapter 7](command:mimic.manualPage?%5B%227%22%5D)",
            "media": {
              "markdown": "walkthrough/learn.md"
            },
            "completionEvents": [
              "onCommand:mimic.manualPage"
            ]
          },
          {
            "id": "ch10",
            "title": "10. Parallel by default",
            "description": "What runs on all cores, and why it is safe.\n[Read chapter 10](command:mimic.manualPage?%5B%2210%22%5D)",
            "media": {
              "markdown": "walkthrough/learn.md"
            },
            "completionEvents": [
              "onCommand:mimic.manualPage"
            ]
          },
          {
            "id": "ch11",
            "title": "11. Projects and modules",
            "description": "`mim.mim`, modules, `pub`, libraries from git.\n[Read chapter 11](command:mimic.manualPage?%5B%2211%22%5D)",
            "media": {
              "markdown": "walkthrough/learn.md"
            },
            "completionEvents": [
              "onCommand:mimic.manualPage"
            ]
          },
          {
            "id": "ch14",
            "title": "14. Tooling",
            "description": "Tests, property tests, contracts, the profiler, the REPL.\n[Read chapter 14](command:mimic.manualPage?%5B%2214%22%5D)",
            "media": {
              "markdown": "walkthrough/learn.md"
            },
            "completionEvents": [
              "onCommand:mimic.manualPage"
            ]
          }
        ]
      }
    ],
