    "taskDefinitions": [
      {
        "type": "mimic",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "test",
              "check",
              "audit",
              "fmt",
              "doc"
            ],
            "description": "The mimic command"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "More arguments"
          },
          "release": {
            "type": "boolean",
            "description": "--release"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "mimic",
        "owner": "mimic",
        "source": "mimic",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning)\\[(\\w+)\\]: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*--> (.*):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "mimic.mcp",
        "label": "Mimic"
      }
    ],
    "notebooks": [
      {
        "type": "mimic-notebook",
        "displayName": "Mimic Notebook",
        "selector": [
          {
            "filenamePattern": "*.mimnb"
          }
        ]
      }
    ]
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "test": "node scripts/check.mjs",
    "package": "vsce package",
    "test:integration": "node test/integration.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.6.2"
  }
}
